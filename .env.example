# Tricode CMS — si quedan vacías, el sitio usa lib/data.ts (modo standalone)
# Producción: https://cms.tricode.studio/api/v1 y calaguala
NEXT_PUBLIC_TRICODE_API_BASE_URL=
NEXT_PUBLIC_TRICODE_TENANT_SLUG=

# Solo servidor (sin NEXT_PUBLIC_): clave de integración del CMS con lectura y
# escritura sobre "Solicitudes de reserva". Sin ella, la disponibilidad queda
# "a confirmar" y las solicitudes se ofrecen por WhatsApp.
TRICODE_INTEGRATION_API_KEY=

# URL pública del sitio (canonical, Open Graph, Schema.org)
NEXT_PUBLIC_SITE_URL=https://calaguala.uy
