# Tricode CMS — si quedan vacías, el sitio usa lib/data.ts (modo standalone)
# Producción: https://cms.tricode.studio/api/v1 y calaguala
NEXT_PUBLIC_TRICODE_API_BASE_URL=
NEXT_PUBLIC_TRICODE_TENANT_SLUG=

# Solo servidor (sin NEXT_PUBLIC_): clave de integración del CMS con lectura y
# escritura sobre "Solicitudes de reserva". Sin ella, la disponibilidad queda
# "a confirmar" y las solicitudes se ofrecen por WhatsApp.
TRICODE_INTEGRATION_API_KEY=

# URL pública del sitio (canonical, Open Graph, Schema.org)
NEXT_PUBLIC_SITE_URL=https://calaguala.uy

# NOTA: el endpoint app/api/revalidate existe pero hoy no se usa, porque los
# webhooks del CMS no están activos. El contenido se actualiza por revalidación
# temporal (300 s) y puede tardar hasta 5 minutos en verse.
# Solo servidor: webhook de revalidación POST /api/revalidate.
# TRICODE_WEBHOOK_SECRET: secreto que muestra el CMS al crear el webhook (firma X-Tricode-Signature).
TRICODE_WEBHOOK_SECRET=
# REVALIDATE_SECRET (opcional): alternativa para pruebas con curl (header x-revalidate-secret).
# Sin ninguna de las dos definidas, el endpoint responde siempre 401.
REVALIDATE_SECRET=
